# このファイルを .env にコピーして使う（.env は Git に入れない）

# アプリの名前（画面の見出し・タブ・共有時のタイトル・メールの件名と本文）。未設定なら「在室カレンダー」。40文字まで
# APP_TITLE=在室カレンダー

# 部屋の合言葉（閲覧用）。未設定なら誰でも開ける
# ROOM_PASSWORD=

# 公開 URL。PW リセットのメールに入る URL の元になる。HTTPS のプロキシの後ろでは必ず設定する
# SMTP_HOST を設定するときは必須（未設定だと、PW リセットのメールは送られない）
# PUBLIC_URL=https://room.example.com

# メール送信（SMTP）。SMTP_HOST が未設定なら、メールは送らずサーバーのコンソールに出す
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=在室カレンダー <noreply@example.com>

# メールを送る要求（登録・コードの再送・パスワード再設定）の上限。超えると 429 を返してメールを送らない
# 要求の回数。同じ IP から 1時間あたり（既定 10）と、全体で 1時間あたり（既定 100）
# 1以上の整数だけ使える（0 は「無効」ではない）。使えない値は、起動時に警告を出して既定の値になる
# MAIL_IP_LIMIT=10
# MAIL_GLOBAL_LIMIT=100
